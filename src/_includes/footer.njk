        <div class="footer-bottom-wrapper">
            <div class="w3c-badges">
                <a class="w3c-html-badge" data-page-path="{{ page.url }}"
                    href="https://validator.w3.org/nu/?doc=https://dietchn.ac.in{{ page.url }}"
                    target="_blank" rel="noopener noreferrer" title="Check this page's HTML5 validity (opens validator.w3.org in a new tab)">
                    <img src="/images/badges/valid-html5.svg" alt="Valid HTML5" width="110" height="34" loading="lazy"></a>
                <a class="w3c-css-badge" data-page-path="{{ page.url }}"
                    href="https://jigsaw.w3.org/css-validator/validator?uri=https://dietchn.ac.in{{ page.url }}"
                    target="_blank" rel="noopener noreferrer" title="Check this page's CSS validity (opens jigsaw.w3.org in a new tab)">
                    <img src="/images/badges/valid-css.svg" alt="Valid CSS" width="110" height="34" loading="lazy"></a>
            </div>
            <script>
                // This site is mirrored on more than one domain. The badge
                // links above default to dietchennai.org (for no-JS/crawlers);
                // rewrite them to whichever domain is actually being viewed.
                (function () {
                    var origin = window.location.origin;
                    var html = document.querySelector('.w3c-html-badge');
                    var css = document.querySelector('.w3c-css-badge');
                    if (html) {
                        html.href = 'https://validator.w3.org/nu/?doc=' + origin + html.getAttribute('data-page-path');
                    }
                    if (css) {
                        css.href = 'https://jigsaw.w3.org/css-validator/validator?uri=' + origin + css.getAttribute('data-page-path');
                    }
                })();
            </script>
            <div class="container common-container four_content footer-bottom-container">
                <div class="footer-content clearfix">
                    <div><i class="fa fa-clock-o" aria-hidden="true"></i>
                        <span id="datetime"></span>
                    </div>
                    <div class="last-updated"><samp data-i18n="updation">Last Updated:</samp>
                        <strong data-cms-field="last_updated"> {{ last_updated }}</strong>
                    </div>
                    <div class="visitor-count">
                        <i class="fa fa-users" aria-hidden="true"></i>
                        <samp data-i18n="visitorcount">Total Visitors: </samp>
                        <strong id="visitor-count-value">&hellip;</strong>
                    </div>
                </div>
            </div>
        </div>
        <script>
            // Total visitor count, served by a Cloudflare Worker that reads
            // this zone's own Cloudflare Analytics data (see
            // /workers/visitor-counter/ in the repo). Fails silently -- if
            // the endpoint is unreachable the counter block just hides
            // itself rather than showing a stale or fake number.
            (function () {
                var valueEl = document.getElementById('visitor-count-value');
                if (!valueEl) return;
                fetch('https://dietchennai.org/api/visitor-count', { cache: 'no-store' })
                    .then(function (res) {
                        if (!res.ok) throw new Error('visitor-count: bad response');
                        return res.json();
                    })
                    .then(function (data) {
                        if (typeof data.total !== 'number') throw new Error('visitor-count: bad payload');
                        valueEl.textContent = data.total.toLocaleString('en-IN');
                    })
                    .catch(function () {
                        var wrap = valueEl.closest('.visitor-count');
                        if (wrap) wrap.style.display = 'none';
                    });
            })();
        </script>
