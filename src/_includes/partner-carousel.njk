{#
  Partner / government logos strip, shared across the homepage and every
  "simple info" page (src/_layouts/simple-info.njk includes this too).
  The list itself lives in src/_data/partnerLogos.json (CMS-editable via
  the "Home Page" collection's "Partner / Government Logos" entry) so
  there is exactly one copy of this data -- previously the homepage kept
  its own separate hardcoded copy of the same 14 logos, which could drift
  out of sync with this file.
#}
    <div class="wrapper carousel-wrapper">
        <div class="container common-container four_content carousel-container">
            <div id="flexCarousel" class="flexslider carousel">
                <ul class="slides">
                    {% for logo in partnerLogos.items %}
                    <li><a target="_blank" href="{{ logo.href }}"
                            title="{{ logo.label }}, External Link that opens in a new window">
                            <img width="{{ logo.width or 200 }}" height="{{ logo.height or 150 }}" loading="lazy" src="{{ logo.image }}" alt="{{ logo.label }}"></a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
