---
layout: base.njk
---
{#
  Shared layout for the "Activities" page family (CMS restructure plan,
  Phase 7). Identical to simple-info.njk's bilingual intro/sections
  rendering (see that file's own header comment for the reasoning behind
  keeping breadcrumb/heading metadata in src/_data/simpleInfoPages.js
  rather than front matter), plus one addition: a structured, CMS-editable
  event list rendered by js/cms-content.js's existing renderList()/
  fetchJSON() mechanism -- the exact pattern announcements/circulars/
  downloads already use, data-cms-list="{{ page.fileSlug }}" fetches
  assets/content/data/<fileSlug>.json. No JS changes were needed for this;
  it's the same generic mechanism, just pointed at a new file per page.
  An empty list degrades to cms-content.js's existing "To be updated"
  fallback, so a page with no events yet still reads as intentional, not
  broken -- matching how every other CMS list on the site already
  behaves when empty.
#}
{% set pageMeta = simpleInfoPages[page.fileSlug] %}
    <!--/.nav-wrapper-->
    <!-- Main and modifiable content starts here -->
    <!-- section divider -->
    <div class="main_content">
        <div class="wrapper" id="skipCont"></div>
        <!--/#skipCont-->
        <div id="fontSize" class="wrapper body-wrapper ">
            <div class="bg-wrapper inner-wrapper">
                <div class="breadcam-bg breadcam">
                    <div class="container common-container four_content">
                        <ul>
                            <li><a href="/" data-i18n="home">Home </a></li>
                            {% if pageMeta.parent %}
                            <li><a href="{{ pageMeta.parent.href }}" data-i18n="{{ pageMeta.parent.i18n }}">{{ pageMeta.parent.label }}</a></li>
                            {% endif %}
                            <li><a href="{{ page.url }}" data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <section id="page-head" class="wrapper headings-wrapper">
                <div class="container common-container four_content">
                    <h1><i class="fa fa-info-circle" aria-hidden="true">&nbsp;</i><samp
                            data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</samp>
                    </h1>
                    <hr />
                </div>
            </section>
            <!--/#page-head-->
            <div>
                {% if intro and (intro.en or intro.ta) %}
                <div class="container common-container four_content">
                    {% if intro.en %}
                    <div class="englishparagraph">
                        {{ intro.en | safe }}
                    </div>
                    {% endif %}
                    {% if intro.ta %}
                    <div class="tamilparagraph">
                        {{ intro.ta | safe }}
                    </div>
                    {% endif %}
                </div>
                {% endif %}

                <div class="container common-container four_content" style="padding: 20px 0;">
                    <ul class="content_list" data-cms-list="{{ page.fileSlug }}" data-cms-limit="0"></ul>
                </div>
            </div>
        </div>
    </div>
    <!-- Main and modifiable content ends here -->
    <!-- section divider -->
    <!--/.body-wrapper-->
{% include "partner-carousel.njk" %}
