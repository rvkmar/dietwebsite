---
layout: base.njk
---
{#
  Shared layout for the "course" page family (CMS restructure plan, Tier 3
  phase 6): courses (index), coursetpd, and coursedeled. All three describe
  a course/programme with the same core shape (an optional bilingual intro,
  optional bilingual eligibility/duration facts, and repeatable bilingual
  sections for syllabus/details) -- modeled on src/_layouts/simple-info.njk's
  breadcrumb/data-file lookup and bilingual .englishparagraph/.tamilparagraph
  convention.

  coursedeled additionally carries a real "apply now" flow (banner image,
  admission-closed notice, and a button-triggered modal pair built earlier
  this project on top of js/modals.min.js) that courses/coursetpd don't have
  -- admin/collections/course.yml gives coursedeled's file entry extra
  fields for this on top of the fields shared with the other two, and this
  template renders that block only when `apply_modal` is present in front
  matter.

  Breadcrumb text and the <h1>/data-i18n key come from
  src/_data/simpleInfoPages.js (looked up by page.fileSlug), same reasoning
  as simple-info.njk/department.njk: Decap's file-collection schema is
  authoritative for the whole front-matter object on save, so structural
  data not listed as a CMS field has to live outside front matter or it
  would be silently dropped on the next editor save.
#}
{% set pageMeta = simpleInfoPages[page.fileSlug] %}
    <!--/.nav-wrapper-->
    <!-- Main and modifiable content starts here -->
    <!-- section divider -->
    <div class="main_content">
        <div class="wrapper" id="skipCont"></div>
        <!--/#skipCont-->
        <div id="fontSize" class="wrapper body-wrapper ">
            <div class="bg-wrapper inner-wrapper">
                <div class="breadcam-bg breadcam">
                    <div class="container common-container four_content">
                        <ul>
                            <li><a href="/" data-i18n="home">Home </a></li>
                            {% if pageMeta.parent %}
                            <li><a href="{{ pageMeta.parent.href }}" data-i18n="{{ pageMeta.parent.i18n }}">{{ pageMeta.parent.label }}</a></li>
                            {% endif %}
                            <li><a href="{{ page.url }}" data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <section id="page-head" class="wrapper headings-wrapper">
                <div class="container common-container four_content">
                    <h1><i class="fa fa-info-circle" aria-hidden="true">&nbsp;</i><samp
                            data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</samp>
                    </h1>
                    <hr />
                </div>
            </section>
            <!--/#page-head-->
            <div>
                {% if banner_image %}
                <div class="course-img-container">
                    <div class="image-container" style="position: relative; display: inline-block; width: 100%; max-width: 80vw;">
                        <img width="851" height="315" loading="lazy" src="{{ banner_image }}" alt="{{ banner_image_alt or pageMeta.label }}"
                            style="width: 100%; height: auto; display: block;">
                        {% if apply_links %}
                        <div class="course-button-overlay">
                            {% if apply_links.instructions_url and (apply_links.instructions_button_label.en or apply_links.instructions_button_label.ta) %}
                            <a class="course-apply-btn" href="{{ apply_links.instructions_url }}" target="_blank" rel="noopener noreferrer">{{ apply_links.instructions_button_label.en or apply_links.instructions_button_label.ta }}</a>
                            {% endif %}
                            {% if apply_links.apply_url and (apply_links.apply_button_label.en or apply_links.apply_button_label.ta) %}
                            <a class="course-apply-btn" href="{{ apply_links.apply_url }}" target="_blank" rel="noopener noreferrer">{{ apply_links.apply_button_label.en or apply_links.apply_button_label.ta }}</a>
                            {% endif %}
                        </div>
                        {% endif %}
                        {% if closed_notice and (closed_notice.en or closed_notice.ta) %}
                        {% if closed_notice.en %}
                        <p class="englishparagraph" lang="en" style="color: #db3b00; text-align: center; font-weight:600;">{{ closed_notice.en | safe }}</p>
                        {% endif %}
                        {% if closed_notice.ta %}
                        <p class="tamilparagraph" lang="ta" style="color: #db3b00; text-align: center; font-weight:600;">{{ closed_notice.ta | safe }}</p>
                        {% endif %}
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                {% if official_link and official_link.url %}
                <p style="text-align: center; margin: 1%; font-style: italic;">
                    {% if official_link.text_en %}<span class="englishparagraph" lang="en">{{ official_link.text_en }} <a href="{{ official_link.url }}" target="_blank" rel="noopener noreferrer" style="color: #0056b3; font-weight: 600;">{{ official_link.link_label_en or official_link.url }}</a></span>{% endif %}
                    {% if official_link.text_ta %}<span class="tamilparagraph" lang="ta">{{ official_link.text_ta }} <a href="{{ official_link.url }}" target="_blank" rel="noopener noreferrer" style="color: #0056b3; font-weight: 600;">{{ official_link.link_label_ta or official_link.link_label_en or official_link.url }}</a></span>{% endif %}
                </p>
                {% endif %}

                {% if intro and (intro.en or intro.ta) %}
                <div class="container common-container four_content">
                    {% if intro.en %}<div class="englishparagraph" lang="en">{{ intro.en | safe }}</div>{% endif %}
                    {% if intro.ta %}<div class="tamilparagraph" lang="ta">{{ intro.ta | safe }}</div>{% endif %}
                </div>
                {% endif %}

                {% if eligibility and (eligibility.en or eligibility.ta) %}
                <div class="container common-container four_content" style="padding: 10px 0;">
                    {% if eligibility.en %}<div class="englishparagraph" lang="en"><h2 data-i18n="eligibility">Eligibility</h2>{{ eligibility.en | safe }}</div>{% endif %}
                    {% if eligibility.ta %}<div class="tamilparagraph" lang="ta"><h2 data-i18n="eligibility">Eligibility</h2>{{ eligibility.ta | safe }}</div>{% endif %}
                </div>
                {% endif %}

                {% if duration and (duration.en or duration.ta) %}
                <div class="container common-container four_content" style="padding: 10px 0;">
                    {% if duration.en %}<div class="englishparagraph" lang="en"><h2 data-i18n="duration">Duration</h2>{{ duration.en | safe }}</div>{% endif %}
                    {% if duration.ta %}<div class="tamilparagraph" lang="ta"><h2 data-i18n="duration">Duration</h2>{{ duration.ta | safe }}</div>{% endif %}
                </div>
                {% endif %}

                {% for section in sections %}
                <div class="container common-container four_content" style="padding: 20px 0;">
                    {% if section.body_en %}
                    <div class="englishparagraph" lang="en">
                        {% if section.heading_en %}<h2>{{ section.heading_en }}</h2>{% endif %}
                        {% if section.image %}
                        <img src="{{ section.image }}" alt="{{ section.image_alt or section.heading_en }}" loading="lazy"
                            class="img-fluid" style="max-width: 100%; height: auto; margin-bottom: 1rem;">
                        {% endif %}
                        {{ section.body_en | safe }}
                    </div>
                    {% endif %}
                    {% if section.body_ta %}
                    <div class="tamilparagraph" lang="ta">
                        {% if section.heading_ta %}<h2>{{ section.heading_ta }}</h2>{% endif %}
                        {% if section.image %}
                        <img src="{{ section.image }}" alt="{{ section.image_alt or section.heading_ta }}" loading="lazy"
                            class="img-fluid" style="max-width: 100%; height: auto; margin-bottom: 1rem;">
                        {% endif %}
                        {{ section.body_ta | safe }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}

                {% if not (intro and (intro.en or intro.ta)) and not sections.length and not (eligibility and (eligibility.en or eligibility.ta)) and not banner_image %}
                <div class="container common-container four_content" style="padding: 40px 0; text-align: center; color: #666;">
                    <p><i>Content for this page will be added soon.</i></p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    <!-- Main and modifiable content ends here -->
    <!-- section divider -->
    <!--/.body-wrapper-->

{% include "partner-carousel.njk" %}
