---
layout: base.njk
---
{#
  Shared layout for the Department page family (CMS restructure plan,
  Tier 2 phase 4): dept-ae, dept-etmd, dept-fiar, dept-pste, dept-tpd, and
  the departments index. Modeled directly on src/_layouts/simple-info.njk
  (same breadcrumb/data-file lookup, same bilingual .englishparagraph/
  .tamilparagraph convention, same optional-image-per-section pattern) but
  with the richer department-specific fields confirmed in the plan's
  Section 2/7: an optional banner image, HOD, a faculty list, repeatable
  activities, and a downloads list.

  Breadcrumb text and the <h1>/data-i18n key still come from
  src/_data/simpleInfoPages.js (looked up by page.fileSlug), same reasoning
  as simple-info.njk: Decap's file-collection schema is authoritative for
  the whole front-matter object on save, so structural data not listed as
  a CMS field has to live outside front matter or it would be silently
  dropped on the next editor save.
#}
{% set pageMeta = simpleInfoPages[page.fileSlug] %}
    <!--/.nav-wrapper-->
    <!-- Main and modifiable content starts here -->
    <!-- section divider -->
    <div class="main_content">
        <div class="wrapper" id="skipCont"></div>
        <!--/#skipCont-->
        <div id="fontSize" class="wrapper body-wrapper ">
            <div class="bg-wrapper inner-wrapper">
                <div class="breadcam-bg breadcam">
                    <div class="container common-container four_content">
                        <ul>
                            <li><a href="/" data-i18n="home">Home </a></li>
                            {% if pageMeta.parent %}
                            <li><a href="{{ pageMeta.parent.href }}" data-i18n="{{ pageMeta.parent.i18n }}">{{ pageMeta.parent.label }}</a></li>
                            {% endif %}
                            <li><a href="{{ page.url }}" data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <section id="page-head" class="wrapper headings-wrapper">
                <div class="container common-container four_content">
                    <h1><i class="fa fa-info-circle" aria-hidden="true">&nbsp;</i><samp
                            data-i18n="{{ pageMeta.i18nKey }}">{{ pageMeta.label }}</samp>
                    </h1>
                    <hr />
                </div>
            </section>
            <!--/#page-head-->
            <div>
                {% if banner_image %}
                <div class="container common-container four_content" style="text-align:center;">
                    <img src="{{ banner_image }}" alt="{{ banner_image_alt or pageMeta.label }}" loading="lazy"
                        class="img-fluid" style="max-width: 100%; height: auto; margin-bottom: 1rem;">
                </div>
                {% endif %}

                {% if intro and (intro.en or intro.ta) %}
                <div class="container common-container four_content">
                    {% if intro.en %}
                    <div class="englishparagraph" lang="en">{{ intro.en | safe }}</div>
                    {% endif %}
                    {% if intro.ta %}
                    <div class="tamilparagraph" lang="ta">{{ intro.ta | safe }}</div>
                    {% endif %}
                </div>
                {% endif %}

                {% if hod and (hod.name or hod.designation) %}
                <div class="container common-container four_content" style="padding: 10px 0;">
                    <h2 data-i18n="hod">Head of Department</h2>
                    <p>{{ hod.name }}{% if hod.designation %}, {{ hod.designation }}{% endif %}</p>
                </div>
                {% endif %}

                {% if faculty and faculty.length %}
                <div class="container common-container four_content" style="padding: 10px 0;">
                    <h2 data-i18n="faculty">Faculty</h2>
                    <ul>
                        {% for member in faculty %}
                        <li>{{ member.name }}{% if member.designation %} — {{ member.designation }}{% endif %}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% for activity in activities %}
                <div class="container common-container four_content" style="padding: 20px 0;">
                    {% if activity.body.en %}
                    <div class="englishparagraph" lang="en">
                        {% if activity.heading_en %}<h2>{{ activity.heading_en }}</h2>{% endif %}
                        {% if activity.image %}
                        <img src="{{ activity.image }}" alt="{{ activity.image_alt or activity.heading_en }}" loading="lazy"
                            class="img-fluid" style="max-width: 100%; height: auto; margin-bottom: 1rem;">
                        {% endif %}
                        {{ activity.body.en | safe }}
                    </div>
                    {% endif %}
                    {% if activity.body.ta %}
                    <div class="tamilparagraph" lang="ta">
                        {% if activity.heading_ta %}<h2>{{ activity.heading_ta }}</h2>{% endif %}
                        {% if activity.image %}
                        <img src="{{ activity.image }}" alt="{{ activity.image_alt or activity.heading_ta }}" loading="lazy"
                            class="img-fluid" style="max-width: 100%; height: auto; margin-bottom: 1rem;">
                        {% endif %}
                        {{ activity.body.ta | safe }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}

                {% if downloads and downloads.length %}
                <div class="container common-container four_content" style="padding: 10px 0;">
                    <h2 data-i18n="downloads">Downloads</h2>
                    <ul>
                        {% for d in downloads %}
                        <li><a href="{{ d.link }}">{{ d.title }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if not (intro and (intro.en or intro.ta)) and not activities.length and not (hod and (hod.name or hod.designation)) and not faculty.length %}
                <div class="container common-container four_content" style="padding: 40px 0; text-align: center; color: #666;">
                    <p><i>Content for this page will be added soon.</i></p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    <!-- Main and modifiable content ends here -->
    <!-- section divider -->
    <!--/.body-wrapper-->
{% include "partner-carousel.njk" %}
